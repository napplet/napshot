{
  "name": "napshot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Missing screenshots for Nostr napplets, captured and labeled.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "pnpm build && node --test --test-concurrency=1 dist/test/*.test.js",
    "start": "node dist/src/main.js",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@kehto/paja": "0.21.0",
    "@napplet/core": "0.34.0",
    "@napplet/nap": "0.34.0",
    "nostr-tools": "2.25.4",
    "playwright": "1.61.0"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.8.0"
}
