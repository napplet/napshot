# Copy to .env, chmod 600, and replace all required values. Never commit a real key.
NAPSHOT_SECRET_KEY=
NAPSHOT_RELAYS=wss://relay.example.com,wss://relay2.example.com
NAPSHOT_BLOSSOM_SERVERS=https://blossom.example.com,https://blossom2.example.com
NAPSHOT_MIN_REPLICAS=2
NAPSHOT_DATA_DIR=./data
NAPSHOT_CHROMIUM=/usr/bin/chromium
NAPSHOT_HOST=127.0.0.1
NAPSHOT_PORT=3080
NAPSHOT_POLL_MS=30000
NAPSHOT_LOOKBACK_SECONDS=86400
# Optional additional trusted screenshot labelers, comma-separated hex pubkeys.
NAPSHOT_TRUSTED_AUTHORS=
